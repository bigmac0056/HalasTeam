# SmartSphere Backend Environment Variables

# JWT Secret for token generation
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenWeather API Key (optional - for weather features)
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google OAuth Credentials (required for Google Sign-In)
# Follow these steps to get your credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project called "SmartSphere"
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add authorized redirect URI: http://localhost:3000/oauth/google/callback
# 6. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/oauth/google/callback

# Server Port (default: 3000)
PORT=3000
